#!/bin/sh
# Refuse to commit secrets. This repository is public, so a key that reaches a
# commit is a key published to the world.
#
# .gitignore already excludes these files, but `git add -f`, a rename, or a file
# created before the ignore rule all get past it. This hook does not.
#
# Enabled with:  git config core.hooksPath .githooks
# (core.hooksPath is local configuration, so each clone must set it once.)

fail() {
  echo "pre-commit: refusing to commit — $1" >&2
  echo "            If this is genuinely safe: git commit --no-verify" >&2
  exit 1
}

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

# 1. Files that exist to hold secrets, by name.
for file in $staged; do
  case "$file" in
    *.local.md|.cdsapirc|*/.cdsapirc|.env|*/.env|.env.*|.git-creds|.git-credentials)
      fail "$file is a secrets file"
      ;;
  esac
done

# 2. A Copernicus key pasted into any other file. Matches the .cdsapirc shape
#    only when the key line carries a real value, so the template's PASTE_HERE
#    and the documented example both pass.
for file in $staged; do
  git show ":$file" 2>/dev/null \
    | grep -qiE '^[[:space:]]*key:[[:space:]]*[0-9a-f]{8}-?[0-9a-f]{4}' \
    && fail "$file looks like it contains a Copernicus ADS key"
done

# 3. A Cloudflare API token pasted in (40 chars of base62-ish, after the name).
for file in $staged; do
  git show ":$file" 2>/dev/null \
    | grep -qE 'CLOUDFLARE_API_TOKEN[[:space:]]*[:=][[:space:]]*[A-Za-z0-9_-]{30,}' \
    && fail "$file looks like it contains a Cloudflare API token"
done

# 4. Shapes no file here should ever contain, whatever it is called. Added on
#    27 October 2026: the Worker's GITHUB_DISPATCH_TOKEN is a GitHub token, and
#    checks 2 and 3 knew nothing about that kind. The shared list lives in
#    scripts/secret-patterns.txt so CI scans for exactly the same things.
patterns="$(git rev-parse --show-toplevel)/scripts/secret-patterns.txt"
if [ -f "$patterns" ]; then
  for file in $staged; do
    [ "$file" = "scripts/secret-patterns.txt" ] && continue
    git show ":$file" 2>/dev/null | grep -qE -f "$patterns" \
      && fail "$file contains something shaped like a credential (see scripts/secret-patterns.txt)"
  done
fi

# 5. The real values. Shapes miss a key in an unexpected format; the values
#    themselves cannot be missed. Read from SECRETS.local.md on this machine
#    only -- the file is never committed, so the values never leave it -- and
#    only strings with letters and digits in them, so ordinary words in the
#    notes (dataset names, say) are never treated as secrets.
local_secrets="$(git rev-parse --show-toplevel)/SECRETS.local.md"
if [ -f "$local_secrets" ]; then
  values=$(grep -oE '[A-Za-z0-9_-]{24,}' "$local_secrets" | grep '[0-9]' | grep '[A-Za-z]' | sort -u)
  if [ -n "$values" ]; then
    for file in $staged; do
      git show ":$file" 2>/dev/null | grep -qF "$values" \
        && fail "$file contains a value from SECRETS.local.md"
    done
  fi
fi

exit 0
