# Copy to .env (git-ignored) and fill in. Production values are GitHub
# Actions secrets with these names; the Worker's GITHUB_DISPATCH_TOKEN is a
# Cloudflare Worker secret (wrangler secret put), and for local `npm run dev`
# goes in .dev.vars, Wrangler's own git-ignored equivalent of this file.

# Copernicus Atmosphere Data Store: https://ads.atmosphere.copernicus.eu/profile
ADS_API_KEY=

# Only for writing to D1 from this machine (the Actions jobs have their own).
# Token from the "Edit Cloudflare Workers" template.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
