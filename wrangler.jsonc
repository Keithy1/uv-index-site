{
  // uvatlas.com — Cloudflare Workers FREE plan only. Nothing here may require Workers Paid.
  // Free-plan constraints that shape this config:
  //   - 10 ms CPU per invocation (fetch/D1 wait time does not count)
  //   - 50 subrequests per invocation  -> EPA's 100 calls cannot run here; it runs in GitHub Actions
  //   - 5 Cron Triggers per account    -> we spend exactly one, on ARPANSA
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uvatlas",
  "main": "src/index.tsx",
  "compatibility_date": "2026-10-20",
  "observability": { "enabled": true },

  // Keep the workers.dev URL alongside the custom domain. Declaring `routes`
  // turns it off by default, and it is useful as a second environment to check
  // against -- it is also the one host where the noindex guard can be seen
  // working regardless of the launch flag.
  "workers_dev": true,

  // The real domain. `custom_domain` makes Cloudflare create and manage the
  // DNS record, so there is nothing to keep in step by hand.
  "routes": [
    { "pattern": "uvatlas.com", "custom_domain": true }
  ],

  "vars": {
    // The launch switch. While this is anything other than "true", every
    // response carries X-Robots-Tag: noindex and robots.txt disallows
    // everything, even on uvatlas.com itself.
    //
    // It stays off until the site is finished. Google forming its first
    // impression of the domain from a half-built site -- no home page, no
    // guide, 404s where the internal links point -- is worse than not being
    // indexed, and far slower to undo than it is to cause.
    "SITE_INDEXABLE": "false"
  },

  // ARPANSA measured readings, every 5 minutes. This is the only cron the Worker owns;
  // EPA (hourly) and CAMS (twice daily) are delay-tolerant and live in GitHub Actions.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "uvatlas",
      // Created 25 Oct 2026 with `wrangler d1 create uvatlas --location wnam`.
      // Western North America: D1's free plan has a single primary region and
      // every cache-miss render reads from it, so this is the compromise for a
      // worldwide site whose largest search volume is the US while Australia
      // still has to be usable. Not a secret; a database id is not a credential.
      "database_id": "36e40279-adf1-4e11-8c0b-4d5b9f9f4686"
    }
  ]
}
