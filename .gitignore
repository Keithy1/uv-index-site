# Python
__pycache__/
*.pyc

# Node / Worker
node_modules/
.wrangler/
dist/

# Fetched data never belongs in the repository
data/

# Secrets. SECRETS.local.md holds API keys in plain text and must never be
# tracked: this repository is public. A pre-commit hook enforces it as well.
*.local.md
.cdsapirc
.env
.venv/
.npm-cache/
.git-creds
.git-credentials

# The design and research documents stay local: this repository is public and
# they contain the commercial strategy. docs/ carries what the build needs.
*.docx

.DS_Store

# Development seed, regenerated from a real CAMS download; never committed.
dev-seed.sql

# Generated SQL from the fetchers; applied, never committed.
sql/
*.grib
